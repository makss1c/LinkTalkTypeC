{
  "bin": "server.js",
  "name": "linktalk-server",
  "version": "1.5.17-linktalk.1",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server.js",
    "build:mediasoup-client": "node scripts/build-mediasoup-client.js",
    "radio:ptt": "node gateway/radioGateway.js ptt",
    "radio:play": "node gateway/radioGateway.js play",
    "radio:monitor": "node gateway/radioGateway.js monitor-rx",
    "radio:record": "node gateway/radioGateway.js record-rx",
    "radio:calibrate": "node gateway/radioGateway.js calibrate-rx",
    "radio:stream": "node gateway/radioGateway.js stream",
    "radio:stream-rx": "node gateway/radioGateway.js stream-rx",
    "gateway:sync": "scripts/sync-gateway-to-pi.sh"
  },
  "keywords": [],
  "author": "makss1c <makss.1c@yandex.ru>",
  "license": "Apache-2.0",
  "description": "LinkTalk \u2014 digital intercom server (WebRTC, mediasoup). Developer: makss1c. Based on Talktome by thepoison606.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "13.0.3",
    "express": "^4.18.2",
    "mediasoup": "^3.26.0",
    "mediasoup-client": "^3.22.0",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pkg": "npm:@yao-pkg/pkg@^6.23.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/socket.io/client-dist/**/*",
      "node_modules/mediasoup/worker/out/Release/*",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/selfsigned/**/*"
    ]
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "mediasoup@3.29.0": true
  },
  "homepage": "https://t.me/makss1c"
}
